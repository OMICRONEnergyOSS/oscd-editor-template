{
  "name": "@omicronenergy/oscd-editor-template",
  "version": "0.0.0",
  "description": "OpenSCD Menu Plugin for loading IEC 61850 SCL files into OpenSCD.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-editor-template.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-editor-template/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec81650"
  ],
  "contributors": [
    "Jakob Vogelsang",
    "OMICRON Electronics GmbH"
  ],
  "author": "Jakob Vogelsang",
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/foundation.js",
    "./oscd-editor-template.js": "./dist/oscd-editor-template.js"
  },
  "files": [
